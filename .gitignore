# Data (bronze/silver/gold artifacts and local warehouse are never committed)
data/bronze/api_responses/*
data/bronze/manifests/*
data/bronze/*/*
data/silver/*
data/gold/*
data/warehouse/*.duckdb
data/warehouse/*.duckdb.wal
# Opt-in full-catalog ingestion profile (config/full_catalog_config.yml)
data/bronze_full_catalog/api_responses/*
data/bronze_full_catalog/manifests/*
data/silver_full_catalog/*
data/gold_full_catalog/*
!data/**/.gitkeep

# Environment / secrets
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
*.egg-info/
# no trailing slash: worktrees symlink .venv to a shared checkout, and a
# symlink does not match a directory-only pattern
.venv
venv/
.pytest_cache/
.coverage
htmlcov/
.ruff_cache/

# dbt
dbt_clinical_trials/target/
dbt_clinical_trials/dbt_target/
dbt_clinical_trials/dbt_packages/
dbt_clinical_trials/logs/
dbt_clinical_trials/profiles.yml
logs/

# Streamlit
.streamlit/secrets.toml

# OS / editors
.DS_Store
.idea/
.vscode/
data/bronze/_schema_drift_*.json

# Linked worktrees
.worktrees/

# Superpowers / agent planning artifacts
docs/superpowers/
.superpowers/
