# Data (bronze/silver/gold artifacts and the local warehouse are never
# committed). Bronze is profile-scoped: data/bronze/<profile_id>/{api_responses,
# manifests,_schema_baseline.json}, which is also why the one-level glob below
# covers baselines and drift reports without naming them.
data/bronze/*/*
data/silver/*
data/gold/*
data/warehouse/*.duckdb
data/warehouse/*.duckdb.wal
!data/**/.gitkeep

# Environment / secrets
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
*.egg-info/
# no trailing slash: worktrees symlink .venv to a shared checkout, and a
# symlink does not match a directory-only pattern
.venv
venv/
.pytest_cache/
.coverage
htmlcov/
.ruff_cache/

# dbt
dbt_clinical_trials/target/
dbt_clinical_trials/dbt_target/
dbt_clinical_trials/dbt_packages/
dbt_clinical_trials/logs/
dbt_clinical_trials/profiles.yml
logs/

# Streamlit
.streamlit/secrets.toml

# OS / editors
.DS_Store
.idea/
.vscode/

# Linked worktrees
.worktrees/

# Superpowers / agent planning artifacts
docs/superpowers/
.superpowers/
