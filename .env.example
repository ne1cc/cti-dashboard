# Clinical Trial Access & Recruitment Competition Intelligence
# Copy to .env and adjust. No secrets are required: ClinicalTrials.gov API v2 is public
# and unauthenticated. These variables control local paths and runtime behavior only.

# --- Paths (relative paths are resolved against the repository root) ---
CTI_PROJECT_ROOT=.
CTI_DATA_DIR=data
CTI_BRONZE_DIR=data/bronze
CTI_SILVER_DIR=data/silver
CTI_GOLD_DIR=data/gold
CTI_DUCKDB_PATH=data/warehouse/clinical_trials.duckdb

# --- Config ---
CTI_CONFIG_PATH=config/project_config.yml

# --- Logging ---
CTI_LOG_LEVEL=INFO

# --- HTTP client overrides (defaults live in config/project_config.yml) ---
# CTI_HTTP_TIMEOUT_SECONDS=30
# CTI_MAX_RETRIES=5

# --- dbt ---
DBT_PROFILES_DIR=dbt_clinical_trials

# Live read API SQLite cache (uvicorn src.api.app:create_app --factory)
CTI_CACHE_PATH=.api_cache.db
